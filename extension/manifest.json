{
  "manifest_version": 3,
  "name": "Orbyte Flow — WhatsApp Web Order Ingest & e-Invoice",
  "version": "1.0.0",
  "description": "Floating AI command overlay for WhatsApp Web turning messy customer chats into verified POs and LHDN e-invoices.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "contextMenus"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Orbyte Flow Settings",
    "default_popup": "popup.html"
  }
}
